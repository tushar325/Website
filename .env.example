DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=bean_bloom
DB_PORT=3306
PORT=3001
NODE_ENV=development

# Razorpay — never store customer card data; Checkout handles PAN/CVV
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin auth token signing (change in production)
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=admin

# Optional CORS allow-list (comma-separated origins). Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Email — order confirmation emails sent when admin verifies a payment
# Gmail: enable 2FA then generate an App Password at myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=your@gmail.com
MAIL_FROM_NAME=Bean & Bloom
